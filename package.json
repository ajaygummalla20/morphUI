{
  "name": "morphui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import ./tests/cloudflare-loader.mjs --test tests/rendered-html.test.mjs",
    "test:db": "bash scripts/sites-env.sh -- node --import tsx --test tests/postgres-schema.test.ts",
    "test:app-state": "node --import tsx --test tests/app-state-schema.test.ts",
    "test:gateway": "bash scripts/sites-env.sh -- node --import tsx --test tests/gateway-policy.test.ts tests/gateway-catalog.test.ts tests/gateway-response.test.ts",
    "test:gateway-service": "npm test --prefix gateway",
    "test:gateway-postgres": "bash scripts/sites-env.sh -- node --import tsx --test tests/gateway-postgres.test.ts",
    "test:workspace": "bash scripts/sites-env.sh -- node --import tsx --test tests/dynamic-workspace.test.ts tests/semantic-catalog.test.ts tests/planner-provider.test.ts tests/workspace-export.test.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "audit:security": "npm audit --audit-level=high && npm audit --prefix gateway --audit-level=high",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:generate:app": "bash scripts/sites-env.sh -- drizzle-kit generate --config drizzle-app.config.ts",
    "db:migrate": "bash scripts/sites-env.sh -- drizzle-kit migrate",
    "db:seed": "bash scripts/sites-env.sh -- node --import tsx db/seed.ts",
    "db:verify": "bash scripts/sites-env.sh -- node --import tsx db/verify.ts",
    "db:studio": "bash scripts/sites-env.sh -- drizzle-kit studio",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed && npm run gateway:provision-reader",
    "gateway:install": "npm ci --prefix gateway",
    "gateway:build": "npm run build --prefix gateway",
    "gateway:typecheck": "npm run typecheck --prefix gateway",
    "gateway:provision-reader": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U morphui -d morphui -f /docker-entrypoint-initdb.d/001-readonly-role.sql",
    "gateway:up": "docker compose up -d --build --wait gateway",
    "gateway:down": "docker compose stop gateway",
    "gateway:logs": "docker compose logs -f gateway"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.70",
    "@ai-sdk/openai": "^4.0.65",
    "@faker-js/faker": "^10.5.0",
    "ai": "^7.0.90",
    "animejs": "^4.5.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.30.0",
    "motion": "^13.0.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.1",
    "@cloudflare/workers-types": "5.20260921.1",
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.136.1"
  },
  "overrides": {
    "vinext@0.0.50": {
      "image-size": "2.0.4"
    }
  },
  "type": "module",
  "displayName": "MorphUI"
}
