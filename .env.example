DATABASE_URL=postgresql://morphui:morphui_dev@localhost:5434/morphui
SEED_SCALE=1
RESET_SEED=false

# MorphUI uses the selected AI provider only to convert a prompt and approved semantic
# catalogue into a typed JSON plan. Customer result rows are never sent to the
# model. An empty key produces an actionable configuration error, never a substitute answer.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MORPH_AI_PLANNER_ENABLED=true
# Explicit compatibility mode is permitted only for synthetic demo sessions.
MORPH_ALLOW_RULE_BASED_PLANNER=false
MORPH_PLANNER_PROVIDER=google
MORPH_PLANNER_MODEL=gemini-flash-latest

# MorphUI sends structured plans to this client-hosted Gateway. Leave empty to
# use the strictly enforced in-process demonstration Gateway instead.
MORPH_GATEWAY_URL=
MORPH_GATEWAY_SERVICE_TOKEN=morph-local-gateway-token-change-me
MORPH_GATEWAY_AUDIT_HASH_SALT=morph-local-audit-salt-change-me
MORPH_ORGANIZATION_ID=org_atlas_insurance

# The client Gateway verifies short-lived RS256 OIDC assertions against the
# client's own identity provider. Replace these example URLs for a real client.
MORPH_GATEWAY_OIDC_ISSUER=https://identity.atlas.example
MORPH_GATEWAY_OIDC_AUDIENCE=morph-gateway
MORPH_GATEWAY_OIDC_JWKS_URL=https://identity.atlas.example/.well-known/jwks.json
MORPH_GATEWAY_OIDC_MAX_TOKEN_AGE_SECONDS=300
MORPH_GATEWAY_OIDC_CLOCK_TOLERANCE_SECONDS=30
MORPH_GATEWAY_OIDC_JWKS_CACHE_SECONDS=300

# Explicit synthetic demo for local development. For a client pilot use oidc.
# Demo cannot be combined with a remote Gateway URL.
MORPH_AUTH_MODE=demo
MORPH_APP_ORIGIN=
MORPH_OIDC_ISSUER=
MORPH_OIDC_AUTHORIZATION_URL=
MORPH_OIDC_TOKEN_URL=
MORPH_OIDC_JWKS_URL=
MORPH_OIDC_CLIENT_ID=
MORPH_OIDC_CLIENT_SECRET=
# Server-only JSON mapping of verified issuer+subject to organization and role.
MORPH_AUTH_MEMBERSHIPS=[]
# Fresh signed request assertions. The client Gateway must trust this issuer/JWKS.
# Keep the RSA private JWK in runtime secret storage, never in Git.
MORPH_ASSERTION_ISSUER=
MORPH_ASSERTION_AUDIENCE=morph-gateway
MORPH_ASSERTION_PRIVATE_JWK=
MORPH_GATEWAY_CONNECTOR_ID=connector_production_postgresql
